# ==============================================================================
# CẤU HÌNH TỰ ĐỘNG SAO LƯU DATABASE LÊN GOOGLE DRIVE
# ==============================================================================

# 1. ID thư mục trên Google Drive sẽ lưu file backup:
#    (Lấy từ URL: https://drive.google.com/drive/folders/<FOLDER_ID>)
GDRIVE_FOLDER_ID=

# 2. Thông tin xác thực Google OAuth 2.0 (Dùng 15GB dung lượng miễn phí của Gmail cá nhân)
GDRIVE_CLIENT_ID=
GDRIVE_CLIENT_SECRET=
GDRIVE_REFRESH_TOKEN=

# 3. Giờ backup tự động mỗi ngày (Mặc định 00:00 tức 12h sáng / 12h đêm)
BACKUP_TIME=00:00

# 4. Múi giờ hệ thống (Mặc định: múi giờ Việt Nam UTC+7)
TZ=Asia/Ho_Chi_Minh

# 5. Thời gian lưu trữ bản sao lưu (ngày) - Tự động xóa bản cũ hơn số ngày này
RETENTION_DAYS=30

# 6. Chạy backup ngay 1 lần khi khởi động container (true/false)
BACKUP_RUN_ON_STARTUP=false
